#----------------------------------------------
# Server Configuration
#----------------------------------------------
# Port number for the server to listen on
PORT=8081

# Environment mode (e.g., development, production, mock_all)
ENV=mock_twilio

# Enable debug logging (e.g., express:*)
DEBUG=express:*

#----------------------------------------------
# Twilio Configuration
#----------------------------------------------
# Your Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Your Twilio Auth Token. This is optional if using API Key/Secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio API Key SID for authentication. 
# Recommended over using Auth Token.
TWILIO_API_KEY_SID=your_twilio_api_key_sid

# Your Twilio API Key Secret for authentication.
# Recommended over using Auth Token.
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

#----------------------------------------------
# Avaya Infinity Configuration
#----------------------------------------------
# Base URL for Avaya Infinity API
AVAYA_INFINITY_HOST=https://core.avaya-gu20.ec.avayacloud.com

# Client ID for Avaya Infinity OAuth2 authentication
AVAYA_INFINITY_CLIENT_ID=messaging-api-d690699f-2e25-4f19-bf33-f897410445a7

# Client Secret for Avaya Infinity OAuth2 authentication
AVAYA_INFINITY_CLIENT_SECRET=wSrhOys1dlMdUA1HjIGjHSl89pXXeNMR

# Webhook secret for validating incoming requests from Avaya Infinity.
# Set this if you have configured a webhook secret for your connector
# in Avaya Infinity Admin Console.
AVAYA_INFINITY_WEBHOOK_SECRET=your_avaya_infinity_webhook_secret
